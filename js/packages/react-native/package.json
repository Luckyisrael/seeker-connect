	"keywords": [
		"solana",
		"solana-mobile",
		"seeker",
		"seeker-connect",
		"wallet",
		"web3",
		"mobile-wallet-adapter",
		"react-native"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/solana-mobile/seeker-connect.git",
		"directory": "js/packages/react-native"
	},
	"homepage": "https://github.com/solana-mobile/seeker-connect/tree/main/js/packages/react-native#readme",
	"type": "module",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@solana-mobile/mobile-wallet-adapter-protocol": "^3.0.0",
